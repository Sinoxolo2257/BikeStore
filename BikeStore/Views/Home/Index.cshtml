@model BikeStore.Models.HomeVM
@{  

    ViewBag.Title = "Home";
}

<div class="container mt-4">

    <h2 class="mb-3">Dashboard</h2>

    <hr />

    <!-- ***** STAFF SECTION ***** -->
    <div class="mb-5">
        <h4>Staff</h4>
        <button class="btn btn-primary mb-2" data-toggle="modal" data-target="#staffCreateModal">Add Staff</button>

        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Store</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Staff)
                {
                    <tr>
                        <td>@s.first_name @s.last_name</td>
                        <td>@s.email</td>
                        <td>@s.stores.store_name</td>
                        <td>@s.phone</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ***** CUSTOMER SECTION ***** -->
    <div class="mb-5">
        <h4>Customers</h4>
        <button class="btn btn-success mb-2" data-toggle="modal" data-target="#customerCreateModal">Add Customer</button>

        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr><th>Name</th><th>Email</th><th>City</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td>@c.first_name @c.last_name</td>
                        <td>@c.email</td>
                        <td>@c.city</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ***** PRODUCTS SECTION ***** -->
    <div class="mb-3">
        <h4>Products</h4>

        <form method="get" class="form-inline mb-2">
            <select name="brandFilter" class="form-control mr-2">
                <option value="">All Brands</option>
                @foreach (var b in Model.Brands)
                {
                    <option value="@b.brand_name" @(b.brand_name == Model.SelectedBrand ? "selected" : "")>@b.brand_name</option>
                }
            </select>

            <select name="categoryFilter" class="form-control mr-2">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.category_name" @(c.category_name == Model.SelectedCategory ? "selected" : "")>@c.category_name</option>
                }
            </select>

            <button type="submit" class="btn btn-info">Filter</button>
        </form>

        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr><th>Name</th><th>Brand</th><th>Category</th><th>Price</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td>@p.product_name</td>
                        <td>@p.brands.brand_name</td>
                        <td>@p.categories.category_name</td>
                        <td>R @p.list_price</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- LOAD MODALS -->
@Html.Partial("~/Views/Staffs/_Create.cshtml", new BikeStoreManagement.Models.staff())
@Html.Partial("~/Views/Customers/_Create.cshtml", new BikeStoreManagement.Models.customer())
