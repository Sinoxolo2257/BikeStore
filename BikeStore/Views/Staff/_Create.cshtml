@model BikeStore.Models.staff

<div class="modal fade" id="staffCreateModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5>Add Staff</h5></div>

            @using (Html.BeginForm("Create", "Staffs", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    @Html.LabelFor(m => m.first_name)
                    @Html.TextBoxFor(m => m.first_name, new { @class = "form-control" })

                    @Html.LabelFor(m => m.last_name)
                    @Html.TextBoxFor(m => m.last_name, new { @class = "form-control" })

                    @Html.LabelFor(m => m.email)
                    @Html.TextBoxFor(m => m.email, new { @class = "form-control" })

                    @Html.LabelFor(m => m.phone)
                    @Html.TextBoxFor(m => m.phone, new { @class = "form-control" })

                    @Html.Label("Store")
                    @Html.DropDownList("store_id", null, "Select Store", new { @class = "form-control" })

                    @Html.HiddenFor(m => m.active, new { Value = "1" })
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
            }
        </div>
    </div>
</div>
